# ==============================================================================
# Enterprise GitIgnore - Fashion E-Commerce Microservices Platform
# ==============================================================================

# ── 1. Critical Security: Secrets & Environment Files (NEVER COMMIT) ─────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
*.jks
credentials.json
service-account*.json

# ── 2. Build Tools, Binaries & Archives ───────────────────────────────────────
target/
**/target/
build/
**/build/
out/
**/out/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
*.7z

# Preserve Maven Wrapper JAR
!.mvn/wrapper/maven-wrapper.jar

# ── 3. IDEs & Editors ─────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/
.factorypath
.springBeans
.sts4-cache/

# ── 4. Operating System Junk ──────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── 5. Logs & Diagnostics ─────────────────────────────────────────────────────
*.log
*.log.*
logs/
**/logs/
hs_err_pid*
replay_pid*

# ── 6. Local Database Mounts & Infrastructure Data ────────────────────────────
postgres_data/
redis_data/
.localstack/
data/