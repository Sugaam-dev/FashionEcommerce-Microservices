          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminJwtToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razorpayEnabled\": true,\n  \"razorpayKeyId\": \"rzp_live_public_key_abc\",\n  \"manualUpiEnabled\": true,\n  \"upiId\": \"payments@storeupi\",\n  \"upiAccountHolder\": \"Fashion Store Retail Pvt Ltd\",\n  \"upiQrCodeUrl\": \"https://cdn.fashionstore.com/qr/live-upi-qr.png\",\n  \"bankName\": \"HDFC Bank\",\n  \"bankAccountNumber\": \"50100998877665\",\n  \"bankIfscCode\": \"HDFC0001234\",\n  \"bankBranch\": \"MG Road Branch, Bengaluru\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/payments/settings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "payments", "settings"]
            }
          }
        }
      ]
    }
  ]
}
