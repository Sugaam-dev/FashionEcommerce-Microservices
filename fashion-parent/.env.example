# ==============================================================================
# FASHION E-COMMERCE MICROSERVICES — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific credentials:
#   cp .env.example .env
#
# DO NOT COMMIT THE ACTUAL '.env' FILE TO VERSION CONTROL.
# ==============================================================================

# ── 1. ENVIRONMENT & ACTIVE PROFILES ──────────────────────────────────────────
ENV=dev
SPRING_PROFILES_ACTIVE=dev

# ── 2. SERVICE PORT ALLOCATION ────────────────────────────────────────────────
GATEWAY_PORT=8088
AUTH_PORT=8081
CATALOG_PORT=8082
ORDER_PORT=8083
PAYMENT_PORT=8084
COUPON_PORT=8085
NOTIFICATION_PORT=8086
INVENTORY_PORT=8087
DISCOVERY_PORT=8761
CONFIG_PORT=8888

# ── 3. POSTGRESQL MULTI-DATABASE CLUSTER ──────────────────────────────────────
# Host port 5433 maps to container port 5432 to avoid collision with local Postgres
DB_HOST=localhost
DB_PORT=5433
HOST_DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password_here

# Isolated Schema Database Names
AUTH_DB_NAME=auth_db
CATALOG_DB_NAME=catalog_db
ORDER_DB_NAME=order_db
PAYMENT_DB_NAME=payment_db
COUPON_DB_NAME=coupon_db
INVENTORY_DB_NAME=inventory_db
NOTIFICATION_DB_NAME=notification_db

# ── 4. REDIS CACHE & DISTRIBUTED LOCK ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── 5. APACHE KAFKA (KRAFT MODE) ──────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ── 6. MEDIA & OBJECT STORAGE (AWS S3 / LOCALSTACK) ───────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET_NAME=fashion-ecommerce-media
AWS_S3_ENDPOINT=http://localhost:4566
LOCALSTACK_PORT=4566

# ── 7. EMAIL & NOTIFICATION DISPATCH (SMTP) ───────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_digit_app_password_here
MAIL_FROM=no-reply@fashion-ecommerce.com
MAIL_FROM_NAME=Fashion E-Commerce
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
ADMIN_NOTIFICATION_EMAIL=admin@fashion-ecommerce.com
DAILY_EMAIL_QUOTA_LIMIT=3000

# ── 8. SECURITY & JWT (HMAC-SHA512 - MINIMUM 64 BYTES) ────────────────────────
APP_JWT_SECRET=replace_with_a_secure_base64_or_random_secret_string_minimum_64_bytes_long_for_hs512
JWT_SECRET=replace_with_a_secure_base64_or_random_secret_string_minimum_64_bytes_long_for_hs512
APP_JWT_ACCESS_EXPIRATION_MS=900000
APP_JWT_REFRESH_EXPIRATION_MS=604800000
APP_JWT_ISSUER=com.pmrgsolution
APP_JWT_AUDIENCE=fashion-ecommerce-client

# Cookie Security Settings
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax
APP_COOKIE_DOMAIN=
APP_COOKIE_ACCESS_NAME=app-jwt
APP_COOKIE_REFRESH_NAME=refreshToken

# ── 9. INTER-SERVICE SECRETS & SIGNATURES ─────────────────────────────────────
# Shared secret for private service-to-service communication
INTERNAL_SERVICE_KEY=replace_with_secure_internal_service_token_for_private_apis
APP_INTERNAL_SERVICE_KEY=replace_with_secure_internal_service_token_for_private_apis

# ── 10. PAYMENT GATEWAYS ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ── 11. OAUTH2 & SOCIAL LOGIN ─────────────────────────────────────────────────
APP_GOOGLE_CLIENT_ID=your_google_oauth2_client_id_here.apps.googleusercontent.com

# ── 12. SERVICE DISCOVERY & CONFIG SERVER ─────────────────────────────────────
EUREKA_SERVER_URL=http://localhost:8761/eureka/
CONFIG_SERVER_URL=http://localhost:8888
EUREKA_CLIENT_ENABLED=true
CONFIG_SERVER_ENABLED=true

# ── 13. CORS ALLOWED ORIGINS ──────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
