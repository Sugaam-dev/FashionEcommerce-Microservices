              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"otpType\": \"REGISTRATION_VERIFICATION\"\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/v1/auth/resend-otp",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "api",
                "v1",
                "auth",
                "resend-otp"
              ]
            },
            "description": "Resends a new verification OTP to customer email on Port 8081."
          }
        },
        {
          "name": "1.4 User Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
