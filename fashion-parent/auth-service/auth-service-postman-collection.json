{
  "info": {
    "name": "Auth Service API (Port 8081)",
    "_postman_id": "auth-service-port-8081-v2",
    "description": "Complete production Postman collection for Auth Service directly on Port 8081. All URLs are unified to http://localhost:8081 and all request bodies contain exact literal demo values (no variable placeholders).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminAccessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Register New User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"SecurePass@123\",\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Morgan\",\n  \"phoneNumber\": \"+919876543210\"\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/v1/auth/register",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Registers a new user account on Port 8081. Sends OTP and creates user in PENDING_VERIFICATION state."
          }
        },
        {
          "name": "1.2 Verify OTP (Account Activation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
                  "    console.log('Saved accessToken & refreshToken to collection variables');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"otp\": \"123456\",\n  \"otpType\": \"REGISTRATION_VERIFICATION\"\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/v1/auth/verify-otp",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "api",
                "v1",
                "auth",
                "verify-otp"
              ]
            },
            "description": "Verifies 6-digit registration OTP code and activates the account."
          }
        },
        {
          "name": "1.3 Resend OTP",
